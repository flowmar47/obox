# =============================================================================
# obox — Remote LLM Server Configuration
# Copy to .env and customize: cp .env.example .env
# Or run ./scripts/setup.sh to generate .env with unique random secrets.
# =============================================================================

# --- Domain & TLS (consumed by: caddy) ---
# Use "http://localhost" for local HTTP, or "your-domain.com" (no scheme)
# for automatic Let's Encrypt HTTPS.
OBOX_DOMAIN=http://localhost

# Email for Let's Encrypt certificates (consumed by: caddy)
OBOX_ACME_EMAIL=admin@example.com

# --- Portainer (reference credential — set via UI on first visit to /portainer) ---
# Portainer CE prompts for an admin password on first visit (min 12 chars);
# setup.sh generates a random value here for your records (not read by the container).
PORTAINER_ADMIN_PASSWORD=change-me-portainer-admin-password

# --- Open WebUI (consumed by: open-webui) ---
# Secret key for session signing (consumed by: open-webui -> WEBUI_SECRET_KEY)
WEBUI_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Enable signup for new users (consumed by: open-webui -> ENABLE_SIGNUP; set false in prod)
WEBUI_ENABLE_SIGNUP=false

# Default admin email (consumed by: open-webui -> ADMIN_EMAIL)
WEBUI_ADMIN_EMAIL=admin@example.com
# Reference admin password generated by setup.sh (create/use on first WebUI setup)
WEBUI_ADMIN_PASSWORD=change-me-webui-admin-password

# --- Ollama (consumed by: scripts/setup.sh, scripts/pull-models.sh, ollama) ---
# Models to pull on setup (comma-separated, consumed by: setup.sh, pull-models.sh)
OLLAMA_MODELS=llama3.2:3b,phi3:mini

# Informational flag; to start with GPU support use: OBOX_GPU=true ./scripts/setup.sh
OLLAMA_GPU_ENABLED=false

# --- Resource limits (optional, consumed by: ollama) ---
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_NUM_PARALLEL=2

# --- LiteLLM (consumed by: litellm, open-webui OPENAI_API_KEY, scripts/healthcheck.sh) ---
LITELLM_MASTER_KEY=sk-obox-change-me-generate-a-secure-key

# --- Grafana (consumed by: grafana) ---
# Admin username (consumed by: grafana -> GF_SECURITY_ADMIN_USER)
GRAFANA_ADMIN_USER=admin
# Admin password (consumed by: grafana -> GF_SECURITY_ADMIN_PASSWORD)
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
# Public URL (consumed by: grafana -> GF_SERVER_ROOT_URL; use https://your-domain.com/grafana/ in prod)
GRAFANA_ROOT_URL=http://localhost/grafana/
# Cookie domain hostname only (consumed by: grafana -> GF_SERVER_DOMAIN)
# GRAFANA_DOMAIN=localhost
