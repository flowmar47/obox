# =============================================================================
# obox — Remote LLM Server Configuration
# Copy to .env and customize: cp .env.example .env
# =============================================================================

# --- Domain & TLS (Caddy reverse proxy) ---
# Set your public hostname. Use "localhost" for local-only development.
OBOX_DOMAIN=localhost

# Email for Let's Encrypt certificates (required for production TLS)
OBOX_ACME_EMAIL=admin@example.com

# --- Portainer (container management) ---
# Initial admin password (min 12 chars). Change after first login.
PORTAINER_ADMIN_PASSWORD=change-me-now-12

# --- Open WebUI (LLM chat interface) ---
# Secret key for session signing (generate: openssl rand -hex 32)
WEBUI_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Enable signup for new users (set false in production)
WEBUI_ENABLE_SIGNUP=false

# Default admin account (created on first run when signup is disabled)
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change-me-now-12

# --- Ollama (LLM runtime) ---
# Models to pull on setup (comma-separated). Leave empty to skip auto-pull.
OLLAMA_MODELS=llama3.2:3b,phi3:mini

# GPU support: set to "true" if NVIDIA GPU is available
OLLAMA_GPU_ENABLED=false

# --- LiteLLM (OpenAI-compatible API gateway) ---
LITELLM_MASTER_KEY=sk-obox-change-me-generate-a-secure-key

# --- Resource limits (optional) ---
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_NUM_PARALLEL=2
