{
	email {$OBOX_ACME_EMAIL:admin@example.com}
}

{$OBOX_DOMAIN:http://localhost} {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Health check endpoint
	handle /health {
		respond "obox ok" 200
	}

	# LiteLLM — OpenAI-compatible API
	handle /v1/* {
		reverse_proxy litellm:4000
	}

	handle_path /litellm/* {
		reverse_proxy litellm:4000
	}

	# Portainer — container management (restrict in production)
	redir /portainer /portainer/ 308
	handle_path /portainer/* {
		reverse_proxy portainer:9000
	}

	# Grafana — monitoring dashboards (GF_SERVER_SERVE_FROM_SUB_PATH=true)
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Open WebUI — fallback for primary chat UI and all subpaths (/_app/*, /api/*, /ws/*)
	handle {
		reverse_proxy open-webui:8080
	}
}
